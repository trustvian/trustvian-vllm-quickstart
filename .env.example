# Copy to .env and edit. Every value has a working default in compose.yaml.

# Trustvian source to build the CLI and trustvian-local from: a branch, a tag
# or a commit SHA. Keep it on the same release as the collector image below.
TRUSTVIAN_REF=v0.12.0

# The Collector is not built: it comes from the signed release image, pinned
# by the digest of its multi-arch index (the v0.12.0 tag is informational).
TRUSTVIAN_COLLECTOR_IMAGE=ghcr.io/trustvian/trustvian-collector:v0.12.0@sha256:65bb1b61d35b57b0a1efb9d237f71d0cc02e7b41d1cd30d4a58023c7d0a022f0

# Host port of the WebUI / API (published on 127.0.0.1 only).
TRUSTVIAN_WEB_PORT=8080

# Where vLLM is.
#   in Compose, on this machine's NVIDIA GPU (docker compose --profile vllm up -d)
VLLM_BASE_URL=http://vllm:8000/v1
#   on another machine (the usual case from a Mac):
#VLLM_BASE_URL=http://gpu-box.local:8000/v1
#   through an SSH tunnel (`ssh -L 8000:localhost:8000 gpu-box`), seen from a container:
#VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_API_KEY=EMPTY

# The model: what vLLM serves (HF id) and the name it serves it under.
# LLM_MODEL is what the agent sends and what Trustvian shows as `llm · …`.
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_MODEL=qwen2.5-7b
VLLM_TOOL_PARSER=hermes
VLLM_MAX_MODEL_LEN=8192
#HUGGING_FACE_HUB_TOKEN=

# How long `agent reference|candidate` waits for /v1/models before giving up.
VLLM_READY_SECONDS=300

# Identity of what dev provisions on the control plane.
TRUSTVIAN_PROJECT=trustvian-vllm-quickstart
TRUSTVIAN_AGENT=support-agent

# Live mode (`docker compose --profile live up -d`): three agents that keep
# working until stopped, each its own run. The defaults are compose.yaml's.
#   LIVE_AGENTS             the roles to run: support, billing, accounts
#   LIVE_INTERVAL_SECONDS   one ticket per agent this often, jittered +-50%
#   LIVE_DRIFT_EVERY        every Nth billing ticket also exports the record
#                           (a new behavior); 0 = never
#   LIVE_MAX_TICKETS        tickets per agent, then stop; 0 = until stopped
#   CRM_ERROR_RATE          share of CRM requests answered 503 (429 for
#                           refunds); 0 = never
#LIVE_AGENTS=support,billing,accounts
#LIVE_INTERVAL_SECONDS=10
#LIVE_DRIFT_EVERY=20
#LIVE_MAX_TICKETS=0
#CRM_ERROR_RATE=0.05
